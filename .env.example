# ==============================================================================
# AI Job Search & Career Agent Configuration
# ==============================================================================
# Choose between 100% private local models (Ollama, LM Studio) or cloud providers.
# No API keys are required if you use local models or standard agent mode.

# --- Local AI Providers (100% Private, Free, No Data Leaves Your Machine) ---
# Ollama (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.3:70b

# LM Studio (Default: http://localhost:1234)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# --- Cloud AI Providers (Optional) ---
# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Mistral AI
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Active Provider Selection: local_ollama | local_lmstudio | anthropic | openai | gemini | agent_native
ACTIVE_AI_PROVIDER=agent_native

# --- Application Tracker & Scraping Boundaries ---
MAX_DISCOVERY_RESULTS=20
MIN_FIT_SCORE_THRESHOLD=70
POSTING_MAX_AGE_DAYS=21
DEFAULT_LOCATION_PREFERENCE=Remote
